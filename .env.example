# Copy this file to `.env` and fill in your Supabase project values.
# Find them in the Supabase Dashboard: Project Settings > API.
#
# The EXPO_PUBLIC_ prefix is required so these are available in the app at runtime.
# Restart `npm start` after changing .env.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The single email allowed to add/edit/delete recipes (magic-link login).
# Everyone else is read-only. Must match the owner email used in the RLS
# policies in supabase/schema.sql.
EXPO_PUBLIC_OWNER_EMAIL=
